# Copy to .env.local and fill in real values. Never commit .env.local.

# Public origin of this site (no trailing slash). Used for absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 4: own backend (Express + MongoDB + Paystack) ---------------------
